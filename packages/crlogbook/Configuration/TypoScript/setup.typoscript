
# Plugin-Registrierung für TYPO3 v13
tt_content.list.20.crlogbook_crlogbook = USER
tt_content.list.20.crlogbook_crlogbook {
    userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
    vendorName = Conrat
    extensionName = Crlogbook
    pluginName = Crlogbook
    controller = Logbook
    action = list
    switchableControllerActions {
        Logbook {
            1 = list
            2 = edit
            3 = updatedrive
            4 = newdrive
            5 = login
            6 = oauth
            7 = logouts
            8 = crons
        }
    }
}

plugin.tx_crlogbook_crlogbook {
    view {
        templateRootPaths.0 = EXT:crlogbook/Resources/Private/Templates/
        templateRootPaths.1 = {$plugin.tx_crlogbook_crlogbook.view.templateRootPath}
        partialRootPaths.0 = EXT:crlogbook/Resources/Private/Partials/
        partialRootPaths.1 = {$plugin.tx_crlogbook_crlogbook.view.partialRootPath}
        layoutRootPaths.0 = EXT:crlogbook/Resources/Private/Layouts/
        layoutRootPaths.1 = {$plugin.tx_crlogbook_crlogbook.view.layoutRootPath}
    }
    persistence {
        storagePid = {$plugin.tx_crlogbook_crlogbook.persistence.storagePid}
        #recursive = 1
    }
    features {
        #skipDefaultArguments = 1
        # if set to 1, the enable fields are ignored in BE context
        ignoreAllEnableFieldsInBe = 0
        # Should be on by default, but can be disabled if all action in the plugin are uncached
        requireCHashArgumentForActionArguments = 1
    }
    mvc {
        #callDefaultActionIfActionCantBeResolved = 1
    }
}

# these classes are only used in auto-generated templates
plugin.tx_crlogbook._CSS_DEFAULT_STYLE (
    textarea.f3-form-error {
        background-color:#FF9F9F;
        border: 1px #FF0000 solid;
    }

    input.f3-form-error {
        background-color:#FF9F9F;
        border: 1px #FF0000 solid;
    }

    .tx-crlogbook table {
        border-collapse:separate;
        border-spacing:10px;
    }

    .tx-crlogbook table th {
        font-weight:bold;
    }

    .tx-crlogbook table td {
        vertical-align:top;
    }

    .typo3-messages .message-error {
        color:red;
    }

    .typo3-messages .message-ok {
        color:green;
    }
)

# Module configuration
module.tx_crlogbook_web_crlogbookcrlogbook {
    persistence {
        storagePid = {$module.tx_crlogbook_crlogbook.persistence.storagePid}
    }
    view {
        templateRootPaths.0 = EXT:crlogbook/Resources/Private/Backend/Templates/
        templateRootPaths.1 = {$module.tx_crlogbook_crlogbook.view.templateRootPath}
        partialRootPaths.0 = EXT:crlogbook/Resources/Private/Backend/Partials/
        partialRootPaths.1 = {$module.tx_crlogbook_crlogbook.view.partialRootPath}
        layoutRootPaths.0 = EXT:crlogbook/Resources/Private/Backend/Layouts/
        layoutRootPaths.1 = {$module.tx_crlogbook_crlogbook.view.layoutRootPath}
    }
}
