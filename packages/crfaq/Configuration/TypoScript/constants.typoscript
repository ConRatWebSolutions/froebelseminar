
plugin.tx_crfaq_crfaq {
    view {
        # cat=plugin.tx_crfaq_crfaq/file; type=string; label=Path to template root (FE)
        templateRootPath = EXT:crfaq/Resources/Private/Templates/
        # cat=plugin.tx_crfaq_crfaq/file; type=string; label=Path to template partials (FE)
        partialRootPath = EXT:crfaq/Resources/Private/Partials/
        # cat=plugin.tx_crfaq_crfaq/file; type=string; label=Path to template layouts (FE)
        layoutRootPath = EXT:crfaq/Resources/Private/Layouts/
    }
    persistence {
        # cat=plugin.tx_crfaq_crfaq//a; type=string; label=Default storage PID
        storagePid =
    }
}
