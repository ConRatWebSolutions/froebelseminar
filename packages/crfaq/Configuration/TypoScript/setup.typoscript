
plugin.tx_crfaq_crfaq {
    view {
        templateRootPaths.0 = EXT:crfaq/Resources/Private/Templates/
        templateRootPaths.1 = {$plugin.tx_crfaq_crfaq.view.templateRootPath}
        partialRootPaths.0 = EXT:crfaq/Resources/Private/Partials/
        partialRootPaths.1 = {$plugin.tx_crfaq_crfaq.view.partialRootPath}
        layoutRootPaths.0 = EXT:crfaq/Resources/Private/Layouts/
        layoutRootPaths.1 = {$plugin.tx_crfaq_crfaq.view.layoutRootPath}
    }
    persistence {
        storagePid = {$plugin.tx_crfaq_crfaq.persistence.storagePid}
        #recursive = 1
    }
    features {
        #skipDefaultArguments = 1
        # if set to 1, the enable fields are ignored in BE context
        ignoreAllEnableFieldsInBe = 0
        # Should be on by default, but can be disabled if all action in the plugin are uncached
        requireCHashArgumentForActionArguments = 1
    }
    mvc {
        #callDefaultActionIfActionCantBeResolved = 1
    }
}

# Plugin registration for TYPO3 v13
tt_content.list.20.crfaq_crfaq = USER
tt_content.list.20.crfaq_crfaq {
    userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
    vendorName = Conrat
    extensionName = Crfaq
    pluginName = Crfaq
    controller = Eintrag
    action = list
    switchableControllerActions {
        Eintrag {
            1 = list
            2 = show
        }
        Kategorie {
            1 = list
        }
    }
}

# these classes are only used in auto-generated templates
plugin.tx_crfaq._CSS_DEFAULT_STYLE (
    textarea.f3-form-error {
        background-color:#FF9F9F;
        border: 1px #FF0000 solid;
    }

    input.f3-form-error {
        background-color:#FF9F9F;
        border: 1px #FF0000 solid;
    }

    .tx-crfaq table {
        border-collapse:separate;
        border-spacing:10px;
    }

    .tx-crfaq table th {
        font-weight:bold;
    }

    .tx-crfaq table td {
        vertical-align:top;
    }

    .typo3-messages .message-error {
        color:red;
    }

    .typo3-messages .message-ok {
        color:green;
    }
)
