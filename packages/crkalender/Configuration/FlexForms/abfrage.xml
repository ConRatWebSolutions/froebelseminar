<T3DataStructure>
	<meta type="array">
		<langChildren>0</langChildren>
		<langDisable>1</langDisable>
	</meta>
	<sheets>
		<Grundeinstellungen>	
			<ROOT>
				<type>array</type>
				<el>
					<settings.category>
						<label>Kategorie</label>
						<config>
							<type>select</type>
							<renderType>selectMultipleSideBySide</renderType>
							<items type="array">
								<numIndex index="0" type="array">
									<numIndex index="0">- Keine Kategorie auswählen -</numIndex>
									<numIndex index="1">0</numIndex>
								</numIndex>
							</items>
							<foreign_table>tx_crkalender_domain_model_kategorie</foreign_table>
							<size>3</size>
							<maxitems>9</maxitems>
							<itemListStyle>width:100%</itemListStyle>
						</config>
					</settings.category>
					<settings.showDats>
						<label>Anzeige</label>
						<config>
							<type>select</type>
							<renderType>selectSingle</renderType>
							<items type="array">
								<numIndex index="0" type="array">
									<numIndex index="0">Abgelaufene nicht anzeigen</numIndex>
									<numIndex index="1">0</numIndex>
								</numIndex>
								<numIndex index="1" type="array">
									<numIndex index="0">auch Abgelaufene anzeigen</numIndex>
									<numIndex index="1">1</numIndex>
								</numIndex>
								<numIndex index="2" type="array">
									<numIndex index="0">nur Abgelaufene anzeigen (Archiv)</numIndex>
									<numIndex index="1">2</numIndex>
								</numIndex>									
							</items>
							<size>1</size>
							<maxitems>1</maxitems>
						</config>
					</settings.showDats>	
					
                    <settings.idshow>
                        <label>Detailseite</label>
                        <config>
                            <type>group</type>
                            <internal_type>db</internal_type>
                            <allowed>pages</allowed>
                            <minitems>0</minitems>
                            <maxitems>200</maxitems>
                            <size>1</size>
                        </config>
                    </settings.idshow>					


                    <settings.containers>
                        <label>Container anzeigen</label>
                        <config>
                            <type>check</type>                           
                            <default>0</default>
                        </config>
                    </settings.containers>	
                    <settings.filters>
                        <label>Filter anzeigen</label>
                        <config>
                            <type>check</type>                           
                            <default>0</default>
                        </config>
                    </settings.filters>
						 
				</el>
			</ROOT>
		</Grundeinstellungen>
		
		<Anzeigeeinstellungen>
			<ROOT>
				<type>array</type>
				<el>
 		 
					
					<settings.Layout>
						<label>Anzeige der Liste</label>
						<config>
							<type>select</type>
							<renderType>selectSingle</renderType>
							<items type="array">
								<numIndex index="0" type="array">
									<numIndex index="0">Tabelle</numIndex>
									<numIndex index="1">table</numIndex>
								</numIndex>
								<numIndex index="1" type="array">
									<numIndex index="0">Kachel</numIndex>
									<numIndex index="1">kachel</numIndex>
								</numIndex>
								<numIndex index="2" type="array">
									<numIndex index="0">Liste</numIndex>
									<numIndex index="1">li</numIndex>
								</numIndex>
								<numIndex index="3" type="array">
									<numIndex index="0">kleine Liste</numIndex>
									<numIndex index="1">smallli</numIndex>
								</numIndex>					 									
							</items>
							<size>1</size>
							<maxitems>1</maxitems>
						</config>
					</settings.Layout>
					

                    <settings.maxcount>
                        <label>Anzahl der Listenelemente</label>
                        <config>
                            <type>input</type>
                            <size>20</size>
                            <max>30</max>
                            <eval>trim</eval>
                        </config>
                    </settings.maxcount>
	

			
				</el>
			</ROOT>
		</Anzeigeeinstellungen>
	</sheets>
</T3DataStructure>
