
# Include JavaScript globally
page.includeJSFooter.crbuchkatalog = EXT:crbuchkatalog/Resources/Public/JavaScript/crbuchkatalog.js

# Plugin-Registrierung für TYPO3 v13
tt_content.list.20.crbuchkatalog_crbuchkatalog = USER
tt_content.list.20.crbuchkatalog_crbuchkatalog {
    userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
    vendorName = Conrat
    extensionName = Crbuchkatalog
    pluginName = Crbuchkatalog
    controller = Eintrag
    action = list
    switchableControllerActions {
        Eintrag {
            1 = list
            2 = show
        }
    }
}

plugin.tx_crbuchkatalog_crbuchkatalog {
    view {
        templateRootPaths.0 = EXT:crbuchkatalog/Resources/Private/Templates/
        templateRootPaths.1 = {$plugin.tx_crbuchkatalog_crbuchkatalog.view.templateRootPath}
        partialRootPaths.0 = EXT:crbuchkatalog/Resources/Private/Partials/
        partialRootPaths.1 = {$plugin.tx_crbuchkatalog_crbuchkatalog.view.partialRootPath}
        layoutRootPaths.0 = EXT:crbuchkatalog/Resources/Private/Layouts/
        layoutRootPaths.1 = {$plugin.tx_crbuchkatalog_crbuchkatalog.view.layoutRootPath}
    }
    persistence {
        storagePid = {$plugin.tx_crbuchkatalog_crbuchkatalog.persistence.storagePid}
        #recursive = 1
    }
    features {
        #skipDefaultArguments = 1
        # if set to 1, the enable fields are ignored in BE context
        ignoreAllEnableFieldsInBe = 0
        # Should be on by default, but can be disabled if all action in the plugin are uncached
        requireCHashArgumentForActionArguments = 1
    }
    mvc {
        #callDefaultActionIfActionCantBeResolved = 1
    }
}

# these classes are only used in auto-generated templates
plugin.tx_crbuchkatalog._CSS_DEFAULT_STYLE (
    textarea.f3-form-error {
        background-color:#FF9F9F;
        border: 1px #FF0000 solid;
    }

    input.f3-form-error {
        background-color:#FF9F9F;
        border: 1px #FF0000 solid;
    }

    .tx-crbuchkatalog table {
        border-collapse:separate;
        border-spacing:10px;
    }

    .tx-crbuchkatalog table th {
        font-weight:bold;
    }

    .tx-crbuchkatalog table td {
        vertical-align:top;
    }

    .typo3-messages .message-error {
        color:red;
    }

    .typo3-messages .message-ok {
        color:green;
    }
)
